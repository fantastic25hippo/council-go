#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"

[ -f "$HOME/.config/council/jules.env" ] && . "$HOME/.config/council/jules.env"

prepend_path_dir() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  case ":${PATH}:" in
    *":${dir}:"*) ;;
    *) PATH="${dir}:${PATH}" ;;
  esac
}

# ~/.grok/bin
# ~/.local/bin
prepend_path_dir "$HOME/.grok/bin"
prepend_path_dir "$HOME/.local/bin"
export PATH

resolve_path() {
  local raw="$1"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  if [ -z "$raw" ]; then
    printf '%s' "${PWD:-$HOME}"
    return
  fi
  case "$raw" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s' "$HOME/${raw#\~/}" ;;
    *) printf '%s' "$raw" ;;
  esac
}

ensure_bin() {
  local bin="$REPO_DIR/bin/council-bin"
  if [ -x "$bin" ]; then
    printf '%s' "$bin"
    return
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is not on PATH; cannot build bin/council-bin" >&2
    exit 1
  fi
  (cd "$REPO_DIR" && go build -o bin/council-bin ./cmd/council) || {
    echo "error: go build failed" >&2
    exit 1
  }
  printf '%s' "$REPO_DIR/bin/council-bin"
}

COUNCIL_BIN="$(ensure_bin)"

start_in_gui() {
  local target_dir="$1"
  shift
  exec gnome-terminal --title='Council' --working-directory="$target_dir" -- \
    bash -lc '
      [ -f "$HOME/.config/council/jules.env" ] && . "$HOME/.config/council/jules.env"
      prepend_path_dir() {
        local dir="$1"
        [ -d "$dir" ] || return 0
        case ":${PATH}:" in
          *":${dir}:"*) ;;
          *) PATH="${dir}:${PATH}" ;;
        esac
      }
      prepend_path_dir "$HOME/.grok/bin"
      prepend_path_dir "$HOME/.local/bin"
      export PATH
      "$0" "$@"
      ret=$?
      echo ""
      read -r -p "Press Enter to close" _dummy || true
      exit $ret
    ' "$COUNCIL_BIN" "$@"
}

have_gui_picker() {
  { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } \
    && command -v zenity >/dev/null 2>&1 \
    && command -v gnome-terminal >/dev/null 2>&1
}

run_here() {
  cd -- "$1"
  exec "$COUNCIL_BIN" "${@:2}"
}

if [ -n "${COUNCIL_START_DIR:-}" ]; then
  resolved_dir="$(resolve_path "$COUNCIL_START_DIR")"
  if [ ! -d "$resolved_dir" ]; then
    echo "error: COUNCIL_START_DIR is not a directory: $resolved_dir" >&2
    exit 1
  fi
  # Already in a TTY (council-here): stay here. Desktop launch with no TTY: new window.
  if [ ! -t 0 ] && [ ! -p /dev/stdin ] && have_gui_picker; then
    start_in_gui "$resolved_dir" "$@"
  fi
  run_here "$resolved_dir" "$@"
fi

if [ ! -t 0 ] && [ ! -p /dev/stdin ] && have_gui_picker; then
  prefill="${PWD:-$HOME}"
  while true; do
    set +e
    raw_dir="$(zenity --file-selection --directory --title="Council: choose the folder to start in" --filename="${prefill}/")"
    zen_status=$?
    set -e
    if [ "$zen_status" -ne 0 ]; then
      exit 0
    fi
    resolved_dir="$(resolve_path "$raw_dir")"
    if [ -d "$resolved_dir" ]; then
      start_in_gui "$resolved_dir" "$@"
    fi
    set +e
    zenity --error --title="Council" --text="The specified path is not an existing folder:

$resolved_dir

Please enter an existing local directory." --no-wrap
    set -e
    prefill="${raw_dir:-${PWD:-$HOME}}"
  done
fi

resolved_dir="${PWD:-$HOME}"
if [ -t 0 ]; then
  default_path="${PWD:-$HOME}"
  while true; do
    printf "Enter folder path for session (default: %s, 'q' to cancel): " "$default_path"
    if ! read -e -r tty_path; then
      exit 0
    fi
    case "$tty_path" in
      q|Q) exit 0 ;;
    esac
    resolved_dir="$(resolve_path "$tty_path")"
    if [ -d "$resolved_dir" ]; then
      break
    fi
    echo "error: '$resolved_dir' is not an existing directory. Please try again." >&2
  done
fi

run_here "$resolved_dir" "$@"
